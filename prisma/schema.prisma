generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  records   CoatingRecord[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoatingRecord {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  imageUrl    String?
  thumbnailUrl String?
  extractedData String // JSON stringified data
  rawOcrText  String?
  degree      String?  @default("")
  stage       String?  @default("")
  note        String?  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  displayName String
  avatar      String?
  role        String   @default("user")
  preferences UserPreference?
  memos       Memo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apps        String   // JSON stringified AppData[] (바탕화면 구성)
  permissions String   @default("{}") // JSON stringified Record<string, any> (앱별 상세 권한)
  updatedAt   DateTime @updatedAt
}

model Memo {
  id        String     @id @default(cuid())
  title     String
  content   String     // Rich text content (HTML or JSON)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  files     MemoFile[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MemoFile {
  id           String   @id @default(cuid())
  memoId       String
  memo         Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  url          String   // File path
  thumbnailUrl String?  // Thumbnail path
  filename     String
  size         Int
  type         String
  createdAt    DateTime @default(now())
}

model MaintenanceRecord {
  id             Int                @id @default(autoincrement())
  checkDate      DateTime           @default(now())
  equipmentName  String
  part           String
  detail         String
  company        String?
  note           String?
  completionDate DateTime?
  images         MaintenanceImage[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model MaintenanceImage {
  id           String            @id @default(cuid())
  recordId     Int
  record       MaintenanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  url          String            // 원본 또는 압축된 원본 경로
  thumbnailUrl String?           // 썸네일 경로
  createdAt    DateTime          @default(now())
}
model ShinsungProduct {
  id        String           @id @default(cuid())
  name      String           @unique
  records   ShinsungRecord[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ShinsungPart {
  id        String           @id @default(cuid())
  name      String           @unique
  records   ShinsungRecord[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ShinsungRecord {
  id            String         @id @default(cuid())
  productId     String
  product       ShinsungProduct @relation(fields: [productId], references: [id])
  partId        String?
  part          ShinsungPart?   @relation(fields: [partId], references: [id])
  imageUrl      String?
  thumbnailUrl  String?
  testDate      String?
  thickness     String?
  extractedData String         // JSON stringified data
  rawOcrText    String?
  ratio         String?
  progress      String?
  note          String?        @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
