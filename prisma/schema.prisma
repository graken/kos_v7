generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id        String          @id @default(cuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  records   CoatingRecord[]
}

model CoatingRecord {
  id            String   @id @default(cuid())
  productId     String
  imageUrl      String?
  extractedData String
  rawOcrText    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  degree        String?  @default("")
  stage         String?  @default("")
  note          String?  @default("")
  thumbnailUrl  String?
  product       Product  @relation(fields: [productId], references: [id])
}

model User {
  id          String          @id @default(cuid())
  username    String          @unique
  displayName String
  role        String          @default("user")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  avatar      String?
  memos       Memo[]
  preferences UserPreference?
}

model UserPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  apps        String
  permissions String   @default("{}")
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Memo {
  id        String     @id @default(cuid())
  title     String
  content   String
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  files     MemoFile[]
}

model MemoFile {
  id           String   @id @default(cuid())
  memoId       String
  url          String
  filename     String
  size         Int
  type         String
  createdAt    DateTime @default(now())
  thumbnailUrl String?
  memo         Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
}

model MaintenanceRecord {
  id             Int                @id @default(autoincrement())
  checkDate      DateTime           @default(now())
  equipmentName  String
  part           String
  detail         String
  company        String?
  note           String?
  completionDate DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  images         MaintenanceImage[]
}

model MaintenanceImage {
  id           String            @id @default(cuid())
  recordId     Int
  url          String
  createdAt    DateTime          @default(now())
  thumbnailUrl String?
  record       MaintenanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model ShinsungProduct {
  id        String           @id @default(cuid())
  name      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  records   ShinsungRecord[]
}

model ShinsungPart {
  id        String           @id @default(cuid())
  name      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  records   ShinsungRecord[]
}

model ShinsungRecord {
  id            String          @id @default(cuid())
  productId     String
  partId        String?
  imageUrl      String?
  thumbnailUrl  String?
  testDate      String?
  thickness     String?
  extractedData String
  rawOcrText    String?
  ratio         String?
  progress      String?
  note          String?         @default("")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  part          ShinsungPart?   @relation(fields: [partId], references: [id])
  product       ShinsungProduct @relation(fields: [productId], references: [id])
}

model WorkPlan {
  id            String   @id @default(cuid())
  planDate      DateTime
  duration      Int      @default(60) // 작업 시간 (분)
  order         Int      @default(0)  // 정렬 순서
  customer      String?  @default("")
  inputProduct  String?  @default("")
  outputProduct String?  @default("")
  outputSize    String?  @default("")
  outputWidth   String?  @default("")
  outputLength  String?  @default("")
  machineName   String?  @default("")
  processType   String?  @default("")
  adhesive      String?  @default("")
  mixingRatio   String?  @default("{}") // JSON string for mixing ratio
  mesh          String?  @default("")
  speed         String?  @default("")
  note          String?  @default("")
  importantNotice String? @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

